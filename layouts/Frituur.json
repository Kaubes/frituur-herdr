{
  "id": "root",
  "type": "row",
  "theme": "Frituur",
  "background": "#1c0f0a",
  "terminal_padding": [12, 8],
  "preview": "layouts/Frituur.png",
  "resizable": false,
  "children": [
    {
      "id": "rail",
      "type": "block",
      "size": { "px": 230 },
      "content": { "mod": "frituur", "props": { "role": "bonnen" } }
    },
    {
      "id": "paal",
      "type": "block",
      "size": { "px": 6 },
      "content": { "mod": "frituur", "props": { "role": "paal" } }
    },
    {
      "id": "rechts",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "vloer",
          "type": "column",
          "divider": { "width": 6, "color": "#5a3018", "hover": "#ffd23f" },
          "children": [
            {
              "id": "zaak",
              "type": "block",
              "size": { "weight": 1 },
              "min": 60,
              "background": "#1c0f0a",
              "content": { "mod": "frituur", "props": { "role": "zaak" } }
            },
            {
              "id": "main",
              "type": "block",
              "size": { "px": 420 },
              "min": 160,
              "background": "#1c0f0a",
              "content": {
                "tab": "active",
                "pane": {
                  "header": { "content": { "mod": "pane" }, "height": 28, "position": "top", "reveal": "always" },
                  "background": "background",
                  "border": { "width": 1, "color": "#3a1f12" },
                  "focus": { "width": 1, "color": "#ffd23f" },
                  "gap": 6,
                  "radius": 0
                }
              }
            }
          ]
        },
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 38 },
          "content": { "mod": "frituur", "props": { "role": "tabs" } }
        }
      ]
    }
  ]
}
